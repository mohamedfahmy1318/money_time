<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (fullBackupContent). Bank SMS bodies waiting for
     delivery and the Keystore-sealed ingest token belong to this device only;
     the secure-storage prefs are unreadable on any other device anyway. -->
<full-backup-content>
    <exclude domain="sharedpref" path="money_time_bank_queue.xml"/>
    <exclude domain="sharedpref" path="money_time_bank_capture.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
</full-backup-content>
